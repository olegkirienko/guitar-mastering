{
  "name": "guitar-course",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.7 <25"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file-if-exists=.env.local --watch --experimental-strip-types server/main.ts",
    "build": "corepack pnpm lint && corepack pnpm build:client && corepack pnpm build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.build.json",
    "start": "node dist-server/main.js",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:foundation": "vitest run build/foundation.acceptance.test.ts server",
    "test:postgres": "REQUIRE_POSTGRES_TESTS=true vitest run --no-file-parallelism server/*.integration.test.ts",
    "smoke:production": "node scripts/smoke-production.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir server/migrations --advisory-lock-mode wait"
  },
  "dependencies": {
    "@untitledui/icons": "^0.0.22",
    "express": "^5.2.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-aria-components": "^1.13.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "railway": "3.11.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.0"
  }
}
