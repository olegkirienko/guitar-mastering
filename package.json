{
  "name": "guitar-course",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "VITE_DEPLOY_TARGET=pages pnpm build",
    "build:worker": "VITE_DEPLOY_TARGET=worker pnpm build",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false",
    "test": "vitest run",
    "test:runtime-schema": "vitest run build/runtime-schema.acceptance.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@untitledui/icons": "^0.0.22",
    "react": "^19.2.0",
    "react-aria-components": "^1.13.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
