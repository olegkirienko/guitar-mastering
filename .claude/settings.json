{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(corepack pnpm test)",
      "Bash(corepack pnpm test:browser)",
      "Bash(corepack pnpm build)",
      "Bash(corepack pnpm lint)",
      "Bash(corepack pnpm evidence:delivery --sha *)",
      "Bash(corepack pnpm smoke:production https://guitar-mastering-web-production-production.up.railway.app)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "mcp__untitledui__list_components",
      "mcp__untitledui__search_components",
      "mcp__untitledui__get_component",
      "mcp__untitledui__get_component_bundle",
      "mcp__untitledui__get_page_templates",
      "mcp__untitledui__search_icons"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(railway *)",
      "mcp__railway",
      "mcp__untitledui__get_page_template_files"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)"
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules"
    ]
  }
}
